# --- build stage: compile gems with build tools ---
FROM ruby:3.3-slim AS build
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      build-essential libsqlite3-dev libyaml-dev git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Gemfile Gemfile.lock ./
RUN gem install bundler && \
    bundle config set --local without 'development test' && \
    bundle install --jobs 4 --retry 3
COPY . .

# --- runtime stage: slim image without build tools ---
FROM ruby:3.3-slim
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      libsqlite3-0 libyaml-0-2 tzdata && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV RAGE_ENV=production BUNDLE_WITHOUT="development:test"
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /app /app
EXPOSE 3000
CMD ["bundle", "exec", "rage", "s", "-b", "0.0.0.0"]
