#!/usr/bin/env ruby
# Standalone scheduler process. Run separately from the web server, because the
# forking app server doesn't reliably run an in-process background thread.
require_relative '../config/application'
require 'rufus-scheduler'
require 'net/http'

# Tell the web process a refresh landed, so it can push a WS "refreshed" signal
# to subscribed clients (the scheduler can't broadcast cross-process itself).
def notify_web
  uri = URI("#{AppConfig.config.internal_base_url}/api/internal/refreshed")
  Net::HTTP.post(uri, '')
rescue StandardError => e
  Rage.logger.warn("notify web failed: #{e.message}")
end

scheduler = Rufus::Scheduler.new

# Fill any snapshots missed while we were down (e.g. a deploy across a whole
# session), so a restart at any hour never costs a data point.
begin
  SnapshotCatchup.call
rescue StandardError => e
  Rage.logger.error("snapshot catch-up failed: #{e.message}")
end

# Price refresh: a clock-aligned cron derived from the app-wide interval setting
# (e.g. */5 within the session window). A 30s watcher re-applies the cron when
# the setting changes, so UI changes take effect without restarting the process.
refresh = { cron: :unset, job: nil }
scheduler.every('30s', first: :now) do
  desired = Schedule.refresh_cron # cron string, or nil when off
  next if desired == refresh[:cron]

  refresh[:job]&.unschedule
  refresh[:job] = nil
  if desired
    # schedule_cron (not cron) returns the Job object, so we can unschedule it
    # later; plain `cron` returns the job id string.
    refresh[:job] = scheduler.schedule_cron(desired) do
      RefreshService.call
      # Once an hour (the top-of-hour tick, whatever the refresh interval) write a
      # snapshot from the prices we just fetched — fresh data, no extra network
      # call, at most one DB write/hour. Keyed by date + upserted, so each run
      # updates today's point and the last (~22:00, US close) finalizes it.
      SnapshotService.call if Time.now.min.zero?
      notify_web
    rescue StandardError => e
      Rage.logger.error("scheduled refresh failed: #{e.message}")
    end
  end
  refresh[:cron] = desired
  Rage.logger.info("refresh schedule set to: #{desired || 'off'}")
rescue StandardError => e
  Rage.logger.error("refresh scheduler watcher failed: #{e.message}")
end

Rage.logger.info('scheduler up — refresh + snapshot run together, clock-aligned from the AppSettings interval')
scheduler.join
