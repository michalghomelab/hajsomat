#!/usr/bin/env ruby
# Standalone scheduler process. Run separately from the web server, because the
# forking app server doesn't reliably run an in-process background thread.
require_relative '../config/application'
require 'rufus-scheduler'

scheduler = Rufus::Scheduler.new

# Price refresh: a 1-minute heartbeat that fires RefreshService once the app-wide
# interval (AppSettings, set from the UI) has elapsed since the last price update
# and the market session is open. Reading the interval each tick means UI changes
# take effect without restarting the scheduler.
scheduler.every('1m', first: :now) do
  minutes = AppSettings.refresh_interval_minutes
  if minutes.positive? && Schedule.market_open?
    last = Schedule.last_price_refresh_at
    RefreshService.call if last.nil? || (Time.now - last) >= minutes * 60
  end
rescue StandardError => e
  Rage.logger.error("scheduled refresh failed: #{e.message}")
end

scheduler.cron(AppConfig.config.snapshot_cron) do
  SnapshotService.call
rescue StandardError => e
  Rage.logger.error("scheduled snapshot failed: #{e.message}")
end

Rage.logger.info("scheduler up — refresh: every 1m gated by AppSettings interval + market hours, " \
                 "snapshot: #{AppConfig.config.snapshot_cron}")
scheduler.join
